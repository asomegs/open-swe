# Open SWE environment template. Copy it to .env in the repository root
# (cp .env.example .env) and fill in the values: langgraph dev and make dev
# load .env, and docker run --env-file .env takes the same file. Restart the
# backend after editing it; it reloads on code changes only.
#
# Open SWE treats an empty value as unset. Commented-out lines are optional
# settings shown with their default or a typical value; uncomment what you
# need. Every variable is declared with a description in agent/config.py.
# docs/DEVELOPMENT.md (local setup) and docs/INSTALLATION.md (deployments)
# say where the values come from.

# --- LangSmith --------------------------------------------------------------------
LANGSMITH_API_KEY=""            # LangSmith → Settings → API Keys; also used for sandboxes and trace links
LANGSMITH_TRACING="true"        # trace runs to LangSmith
LANGSMITH_PROJECT=""            # optional project for traces and "View trace" links; default "default"
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"   # self-hosted or regional LangSmith

# --- Models -----------------------------------------------------------------------
# One model credential is enough: a provider key, an LLM gateway key, or the Codex CLI
# ChatGPT login (docs/INSTALLATION.md, "Model providers and API keys").
ANTHROPIC_API_KEY=""            # the default model is Anthropic when this is the only provider key
# OPENAI_API_KEY=""             # the default model is OpenAI when this is set
# GOOGLE_API_KEY=""             # google_genai: models
# FIREWORKS_API_KEY=""          # fireworks: models
# GROQ_API_KEY=""               # groq: models
# BASETEN_API_KEY=""            # baseten: models

# LiteLLM or another OpenAI-compatible gateway (docs/CUSTOMIZATION.md, "Adding models
# from an OpenAI-compatible gateway"): OPENAI_API_KEY holds the gateway's key and its
# models are named openai:<model_name>.
# OPENAI_BASE_URL="http://localhost:4000/v1"
# OPEN_SWE_EXTRA_MODELS_FILE="extra-models.json"   # makes the gateway's models selectable; example in examples/extra-models.json
# OPENAI_USE_RESPONSES_API="false"                 # send Chat Completions when the gateway cannot serve /v1/responses

# LangSmith LLM Gateway instead of per-provider keys.
# LANGSMITH_GATEWAY_API_KEY=""                     # LangSmith key with gateway:invoke; setting it turns the gateway on
# LANGSMITH_GATEWAY_ENABLED="true"                 # force the gateway on or off regardless of the key
# LANGSMITH_GATEWAY_BASE_URL="https://gateway.smith.langchain.com"

# Codex CLI ChatGPT login for openai: models; leave OPENAI_API_KEY unset.
# OPEN_SWE_CODEX_AUTH_FILE="~/.codex/auth.json"

# Which model runs when no workspace or profile setting applies.
# LLM_MODEL_ID="anthropic:claude-opus-5"           # provider:model; the default follows the provider keys above
# LLM_REASONING_EFFORT="medium"                    # low, medium, high, max
# LLM_FALLBACK_MODEL_ID="openai:gpt-5.6-sol"       # used when the primary provider fails; gateway models get none by default
# EXA_API_KEY=""                                   # enables the web search tool

# --- GitHub App -------------------------------------------------------------------
GITHUB_APP_ID=""                # docs/DEVELOPMENT.md step 2, docs/INSTALLATION.md step 3
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"   # one double-quoted line, \n between the PEM lines
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_INSTALLATION_ID=""
ALLOWED_GITHUB_USERS=""         # comma-separated GitHub logins allowed to log in; required unless ALLOWED_GITHUB_ORGS is set
# ALLOWED_GITHUB_ORGS=""        # comma-separated orgs whose members may log in; all of their repos are allowed
# ALLOWED_GITHUB_REPOS=""       # comma-separated owner/repo pairs allowed for webhooks
# PUBLIC_REPO_ORG_GATE=""       # single org whose members may trigger runs on public repos
# OPEN_SWE_MENTION_TAGS=""      # comma-separated handles this deployment answers to
# OPEN_SWE_UNASSIGNED_REPO_WORKSPACE="default"   # events for a repo no workspace owns: "default" routes them to the default workspace, "ignore" drops them

# --- Slack ------------------------------------------------------------------------
SLACK_BOT_TOKEN=""              # OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_SIGNING_SECRET=""         # Basic Information → App Credentials
SLACK_BOT_USER_ID=""            # the bot's member id (bot profile → ⋮ → Copy member ID)
SLACK_BOT_USERNAME=""           # the bot's handle, e.g. open_swe_you
SLACK_PUBLIC_BASE_URL=""        # local backend: your ngrok domain, https://<name>.ngrok-free.dev; deployments leave it unset (defaults to DASHBOARD_API_BASE_URL)
# SLACK_APP_ID=""               # Slack app id (A...) whose event deliveries Incidents accepts
# SLACK_CLIENT_ID=""            # Sign in with Slack
# SLACK_CLIENT_SECRET=""
# SLACK_TEAM_ID=""              # restrict Sign in with Slack to one workspace
# LINEAR_WEBHOOK_SECRET=""      # Linear webhook deliveries

# --- Dashboard --------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=""         # openssl rand -base64 32  (encrypts stored GitHub and Slack tokens)
DASHBOARD_JWT_SECRET=""         # openssl rand -hex 32     (signs the session cookie and OAuth state)
CONFIGURED_ADMINS=""            # comma-separated GitHub logins or emails; admins see the Admin pages
# LANGGRAPH_URL="http://localhost:2024"   # the deployment's own URL; the two below default to it
# DASHBOARD_BASE_URL=""
# DASHBOARD_API_BASE_URL=""
# DASHBOARD_ALLOWED_ORIGINS=""  # comma-separated extra origins allowed for credentialed CORS

# --- Database ---------------------------------------------------------------------
POSTGRES_URI=""                 # local dev defaults to postgresql://postgres:postgres@127.0.0.1:5433/postgres, the container make dev starts; set this to use another database
# TEST_ANALYTICS_POSTGRES_URI="postgresql+asyncpg://<user>@localhost:5432/open_swe_test"   # test suite only; a separate database

# --- Sandboxes --------------------------------------------------------------------
# SANDBOX_TYPE="langsmith"      # langsmith (default; uses LANGSMITH_API_KEY), modal, daytona, runloop, e2b, or local (no isolation; development only)
# DAYTONA_API_KEY=""
# E2B_API_KEY=""
# RUNLOOP_API_KEY=""

# --- Dashboard dev server against a deployment (pnpm run dev:prod) ------------------
# DASHBOARD_API_URL="https://your-deployment.example.com"   # the only key the UI dev server reads from .env
